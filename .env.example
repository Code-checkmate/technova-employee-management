# ==============================================================================
# TechNova Employee Management System — Environment Configuration Template
# ==============================================================================
# NOTE: This file is a template and contains placeholder variables.
# Do NOT commit your actual .env file with real secrets or credentials to source control.
#
# To use:
#   cp .env.example .env
#   # Then edit .env with your specific environment configurations.
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Flask Secret Key
# Generate a secure key using: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key-32-chars-long

# Database Mode: "sqlite" (default for local development) or "mysql"
DATABASE_MODE=sqlite

# Local SQLite Database Path (Used when DATABASE_MODE=sqlite)
# Stored inside the local instance_data/ directory by default
SQLITE_DB_PATH=instance_data/technova_employees.db

# ==============================================================================
# MySQL Database Configuration (Used when DATABASE_MODE=mysql)
# Supports Amazon RDS for MySQL and Amazon Aurora MySQL cluster endpoints.
# ==============================================================================
# Example RDS Host:   technova-db.c9akxxxxxx.us-east-1.rds.amazonaws.com
# Example Aurora Host: technova-aurora-cluster.cluster-c9akxxxxxx.us-east-1.rds.amazonaws.com
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=technova_employees
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT=5

# Optional SQLAlchemy Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
